{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "site": "zedatechecker",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
